APP_ENV=local
# Produkcyjnie ZAWSZE false - przy true ślady stosu (stack trace) trafiają do odpowiedzi JSON.
# Lokalnie możesz ustawić true.
APP_DEBUG=false
# Nazwa sklepu - m.in. w nadawcy i temacie e-maili
APP_NAME=slimCommerce

# Publiczny adres, pod którym działa API - baza dla adresów wgranych plików
# (zdjęcia produktów w public/uploads/). Puste = schemat + Host bieżącego
# żądania (wystarcza lokalnie); produkcyjnie USTAW na sztywno, np. https://api.example.com
APP_URL=

# Plik logu błędów PHP (błędy nigdy nie idą do odpowiedzi). Ścieżka względna do
# katalogu projektu albo bezwzględna. Na shared hostingu logu Apache zwykle nie
# widać - ten plik jest jedynym miejscem, gdzie zobaczysz błędy produkcyjne.
# Pusta wartość = domyślny error_log PHP.
LOG_PATH=storage/logs/php-error.log

# Ścieżka do pliku bazy SQLite, względna do katalogu głównego projektu
DB_DATABASE=database/database.sqlite
# Tryb WAL SQLite: odczyty nie blokują zapisów (mniej "database is locked" przy
# równoległych żądaniach). Obok bazy pojawią się pliki -wal i -shm.
DB_SQLITE_WAL=true
# Ile ms czekać na zwolnienie blokady bazy zamiast od razu zwracać błąd
DB_BUSY_TIMEOUT_MS=5000
# true  = migracje i seed superadmina przy każdym żądaniu (wygodne lokalnie)
# false = tylko ręcznie: `php bin/migrate.php` (CLI) albo
#         POST /api/admin/migrate z nagłówkiem X-Migrate-Key: <MIGRATE_SECRET>
#         (shared hosting bez SSH - po wgraniu nowej wersji plików)
DB_AUTO_MIGRATE=true
# Sekret dla POST /api/admin/migrate. Puste = endpoint wyłączony (404).
# Wygeneruj np. `php -r "echo bin2hex(random_bytes(24));"`
MIGRATE_SECRET=

# Sekret do podpisywania tokenów JWT (api/admin) - min. 32 znaki (wymóg HS256),
# ZMIEŃ na losowy ciąg produkcyjnie, np. `php -r "echo bin2hex(random_bytes(32));"`
JWT_SECRET=change-this-to-a-random-secret-of-at-least-32-chars
JWT_TTL=3600

# E-mail (potwierdzenie zamówienia po checkoucie).
# MAIL_MAILER: smtp = realna wysyłka, log = treść do pliku logu (dev), none = wyłączone.
# Na shared hostingu użyj skrzynki SMTP założonej w panelu hostingu (nie mail()).
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls (STARTTLS, port 587) | ssl (SMTPS, port 465) | none
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Originy, którym wolno wywoływać API z przeglądarki (nagłówek CORS). `*` (domyślnie)
# zezwala na wszystko - wygodne lokalnie. Produkcyjnie wpisz tu tylko origin
# panelu admina (lub zostaw puste) - domeny storefrontów dodajesz w panelu jako
# "Miejsca sprzedaży" (tabela sales_channels), aktywne wchodzą na listę CORS
# automatycznie. Np.:
# CORS_ALLOWED_ORIGIN=https://admin.example.com
CORS_ALLOWED_ORIGIN=*
