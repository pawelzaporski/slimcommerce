APP_ENV=local
APP_DEBUG=true

# Publiczny adres, pod którym działa API - baza dla adresów wgranych plików
# (zdjęcia produktów w public/uploads/). Puste = schemat + Host bieżącego
# żądania (wystarcza lokalnie); produkcyjnie ustaw np. https://api.example.com
APP_URL=

# Ścieżka do pliku bazy SQLite, względna do katalogu głównego projektu
DB_DATABASE=database/database.sqlite

# Sekret do podpisywania tokenów JWT (api/admin) - min. 32 znaki (wymóg HS256),
# ZMIEŃ na losowy ciąg produkcyjnie, np. `php -r "echo bin2hex(random_bytes(32));"`
JWT_SECRET=change-this-to-a-random-secret-of-at-least-32-chars
JWT_TTL=3600

# Originy, którym wolno wywoływać API z przeglądarki (nagłówek CORS). `*` (domyślnie)
# zezwala na wszystko - wygodne lokalnie. Produkcyjnie wpisz tu tylko origin
# panelu admina (lub zostaw puste) - domeny storefrontów dodajesz w panelu jako
# "Miejsca sprzedaży" (tabela sales_channels), aktywne wchodzą na listę CORS
# automatycznie. Np.:
# CORS_ALLOWED_ORIGIN=https://admin.example.com
CORS_ALLOWED_ORIGIN=*
