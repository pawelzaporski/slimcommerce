{
    "name": "pytrade/slim-commerce",
    "description": "Headless e-commerce API built on Slim 4 + Eloquent (SQLite)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "firebase/php-jwt": "^7.1",
        "illuminate/database": "^11.0",
        "phpmailer/phpmailer": "^6.9",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.13",
        "vlucas/phpdotenv": "^5.6",
        "zircote/swagger-php": "^4.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "docs": "php bin/generate-openapi.php"
    }
}
